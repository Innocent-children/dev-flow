{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/bin/dev-flow-zcode.mjs", "hook", "pre-tool-use"],
            "timeoutMs": 30000
          }
        ]
      }
    ]
  }
}
