{
  "description": "TaskBelay checks supported file writes against the active Task Plan before execution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "taskbelay-codex hook pre-tool-use",
            "timeout": 30,
            "statusMessage": "Checking TaskBelay file scope"
          }
        ]
      }
    ]
  }
}
