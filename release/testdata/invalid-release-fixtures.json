{
  "schema_version": 1,
  "cases": [
    {
      "name": "secret-token",
      "target": "manifest",
      "operation": "set",
      "path": ["token"],
      "value": "example-token-marker",
      "expected_error": "forbidden field token"
    },
    {
      "name": "npm-auth-file",
      "target": "manifest",
      "operation": "set",
      "path": ["package_files", 0, "path"],
      "value": ".npmrc",
      "expected_error": "forbidden auth file"
    },
    {
      "name": "absolute-home-path",
      "target": "manifest",
      "operation": "set",
      "path": ["artifacts", 0, "relative_path"],
      "value": "/workspace/example",
      "expected_error": "unsafe relative path"
    },
    {
      "name": "environment-value",
      "target": "manifest",
      "operation": "set",
      "path": ["environment"],
      "value": "HOME=/workspace/example",
      "expected_error": "forbidden field environment"
    },
    {
      "name": "raw-prompt",
      "target": "publication",
      "operation": "set",
      "path": ["raw_prompt"],
      "value": "example public prompt marker",
      "expected_error": "forbidden field raw_prompt"
    },
    {
      "name": "unbounded-command-output",
      "target": "publication",
      "operation": "set",
      "path": ["raw_command_output"],
      "value": "example raw command output marker",
      "expected_error": "forbidden field raw_command_output"
    },
    {
      "name": "unsafe-relative-path",
      "target": "manifest",
      "operation": "set",
      "path": ["artifacts", 1, "relative_path"],
      "value": "../escape.tgz",
      "expected_error": "unsafe relative path"
    },
    {
      "name": "deepseek-component",
      "target": "manifest",
      "operation": "set",
      "path": ["artifacts", 1, "name"],
      "value": "dev-flow-deepseek-0.1.0.tgz",
      "expected_error": "DeepSeek content"
    },
    {
      "name": "extra-platform",
      "target": "manifest",
      "operation": "append",
      "path": ["support"],
      "value": {
        "os": "linux",
        "arch": "x64",
        "actual_codex_version": "0.147.0",
        "compatible_codex_range": ">=0.147.0 <0.148.0",
        "package_sha256": "1111111111111111111111111111111111111111111111111111111111111111",
        "core_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "journey_result": "pending",
        "journey_observed_at": null,
        "notes": "Negative extra-platform fixture."
      },
      "expected_error": "exactly one support entry"
    },
    {
      "name": "digest-mismatch",
      "target": "manifest",
      "operation": "set",
      "path": ["support", 0, "package_sha256"],
      "value": "3434343434343434343434343434343434343434343434343434343434343434",
      "expected_error": "support package digest"
    },
    {
      "name": "npm-token",
      "target": "publication",
      "operation": "set",
      "path": ["npm_token"],
      "value": "example-token-marker",
      "expected_error": "forbidden field npm_token"
    },
    {
      "name": "auth-header",
      "target": "publication",
      "operation": "set",
      "path": ["auth_header"],
      "value": "Authorization: Bearer example-public-marker",
      "expected_error": "forbidden field auth_header"
    },
    {
      "name": "temporary-machine-path",
      "target": "manifest",
      "operation": "set",
      "path": ["validations", 0, "summary"],
      "value": "/private/var/folders/example-release-output",
      "expected_error": "machine absolute path"
    },
    {
      "name": "raw-stderr",
      "target": "publication",
      "operation": "set",
      "path": ["raw_stderr"],
      "value": "example stderr marker",
      "expected_error": "forbidden field raw_stderr"
    },
    {
      "name": "raw-stdout",
      "target": "publication",
      "operation": "set",
      "path": ["raw_stdout"],
      "value": "example stdout marker",
      "expected_error": "forbidden field raw_stdout"
    },
    {
      "name": "unbounded-summary",
      "target": "manifest",
      "operation": "repeat",
      "path": ["validations", 0, "summary"],
      "value": "x",
      "count": 1001,
      "expected_error": "unbounded summary"
    },
    {
      "name": "artifact-source-mismatch",
      "target": "manifest",
      "operation": "set",
      "path": ["artifacts", 0, "source_commit"],
      "value": "ffffffffffffffffffffffffffffffffffffffff",
      "expected_error": "identity differs from the release"
    }
  ]
}
