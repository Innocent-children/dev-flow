{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/schemas/release-manifest.schema.json",
  "title": "Dev Flow Codex Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release",
    "toolchains",
    "artifacts",
    "package_files",
    "support",
    "validations"
  ],
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "core_version",
        "tag",
        "source_commit",
        "source_tree",
        "verification_mode",
        "based_on_release",
        "created_at"
      ],
      "properties": {
        "product": {
          "const": "codex"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-beta\\.(0|[1-9][0-9]*))?$"
        },
        "core_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tag": {
          "type": "string",
          "pattern": "^codex-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-beta\\.(0|[1-9][0-9]*))?$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verification_mode": {
          "enum": [
            "quick",
            "normal"
          ]
        },
        "based_on_release": {
          "type": "string",
          "pattern": "^(?:v0\\.5\\.0|codex-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-beta\\.(?:0|[1-9][0-9]*))?)$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go",
        "node",
        "pnpm",
        "npm",
        "git",
        "gh"
      ],
      "properties": {
        "go": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pnpm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "npm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "git": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "gh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "relative_path",
          "size_bytes",
          "sha256",
          "mode",
          "source_commit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "npm_tarball",
              "core_binary"
            ]
          },
          "relative_path": {
            "$ref": "#/$defs/relativePath"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          },
          "npm_integrity": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "source_commit": {
            "$ref": "#/$defs/gitSha"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "npm_tarball"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "core_binary"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "package_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "mode"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          }
        }
      }
    },
    "support": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "arch",
          "actual_codex_version",
          "compatible_codex_range",
          "package_sha256",
          "core_sha256",
          "journey_result",
          "journey_observed_at",
          "verification_mode",
          "based_on_release",
          "notes"
        ],
        "properties": {
          "os": {
            "const": "darwin"
          },
          "arch": {
            "const": "arm64"
          },
          "actual_codex_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "compatible_codex_range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "package_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "core_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "journey_result": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked"
            ]
          },
          "journey_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "verification_mode": {
            "enum": [
              "quick",
              "normal"
            ]
          },
          "based_on_release": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+,-]+(?:/[A-Za-z0-9._@+,-]+)*$",
      "maxLength": 300
    }
  }
}
