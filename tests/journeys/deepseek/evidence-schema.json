{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature 010 Final Native DeepSeek Evidence",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/historicalFailedAttempt" },
    { "$ref": "#/$defs/failedAttempt3" },
    { "$ref": "#/$defs/failedAttempt4" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "passed": { "const": "passed" },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class", "status", "native_attempt", "source_commit", "artifact",
        "embedded_core", "dsh", "runtime", "core_contract", "task", "recovery",
        "stages", "outcomes", "release_effects"
      ],
      "properties": {
        "evidence_class": { "const": "final_native_graph_acceptance" },
        "status": { "const": "passed" },
        "native_attempt": { "const": 4 },
        "source_commit": { "$ref": "#/$defs/gitCommit" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "size", "sha256"],
          "properties": {
            "filename": { "type": "string", "pattern": "^[^/\\\\]+\\.tgz$" },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "embedded_core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "size", "sha256", "reported_version"],
          "properties": {
            "filename": { "const": "runtime/darwin-arm64/dev-flow" },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "reported_version": { "const": "dev-flow 0.5.0" }
          }
        },
        "dsh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "integrity", "source_commit"],
          "properties": {
            "version": { "const": "0.1.0-rc.8" },
            "integrity": { "const": "sha512-VQU5NlomrKLRgcXuOf+sxWFvqxPA8q9vMhrKPlPPXiOJEhGlGlAdiyxZvZxkCVI+v0zbhe21cY3/luLyxpSzzA==" },
            "source_commit": { "const": "141eb6fef83422698aef7a981029e843e8161534" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "pnpm", "os", "architecture", "profile_identity_sha256"],
          "properties": {
            "node": { "type": "string", "pattern": "^v24\\." },
            "pnpm": { "type": "string", "pattern": "^11\\." },
            "os": { "const": "darwin" },
            "architecture": { "const": "arm64" },
            "profile_identity_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "core_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "core_limits_version", "process_id", "process_version",
            "process_definition_digest", "qualified_tools"
          ],
          "properties": {
            "schema_version": { "const": 2 },
            "core_limits_version": { "const": "0.2" },
            "process_id": { "const": "standard-development" },
            "process_version": { "const": 1 },
            "process_definition_digest": { "$ref": "#/$defs/sha256" },
            "qualified_tools": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "prefixItems": [
                { "const": "mcp__dev_flow__dev_flow_server_info" },
                { "const": "mcp__dev_flow__dev_flow_open_task" },
                { "const": "mcp__dev_flow__dev_flow_get_task" },
                { "const": "mcp__dev_flow__dev_flow_get_next_action" },
                { "const": "mcp__dev_flow__dev_flow_apply_action" },
                { "const": "mcp__dev_flow__dev_flow_cancel_task" }
              ],
              "items": false
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id", "initial_revision", "interrupted_revision", "recovered_revision",
            "comprehension_revision", "terminal_revision", "terminal_state"
          ],
          "properties": {
            "task_id": { "type": "string", "pattern": "^task-[0-9a-f]+$" },
            "initial_revision": { "type": "integer", "minimum": 1 },
            "interrupted_revision": { "type": "integer", "minimum": 1 },
            "recovered_revision": { "type": "integer", "minimum": 1 },
            "comprehension_revision": { "type": "integer", "minimum": 1 },
            "terminal_revision": { "type": "integer", "minimum": 1 },
            "terminal_state": { "const": "DONE" }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interruption_classification", "read_sequence", "repeated_mutation_before_read"],
          "properties": {
            "interruption_classification": {
              "enum": ["result_unanswered", "result_recorded_before_interrupt"]
            },
            "read_sequence": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "const": "mcp__dev_flow__dev_flow_get_task" },
                { "const": "mcp__dev_flow__dev_flow_get_next_action" }
              ],
              "items": false
            },
            "repeated_mutation_before_read": { "const": false }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "timeout_ms", "from_node", "to_node", "from_revision", "to_revision", "progress"
            ],
            "properties": {
              "id": {
                "enum": [
                  "recovery-read", "design", "task-planning", "implementation", "test",
                  "comprehension-reject", "refactor", "retest", "comprehension-accept", "delivery"
                ]
              },
              "timeout_ms": { "enum": [120000, 180000] },
              "from_node": {
                "enum": ["DESIGN", "TASKS", "IMPLEMENT", "TEST", "COMPREHENSION_REVIEW", "REFACTOR", "DELIVERY"]
              },
              "to_node": {
                "enum": ["DESIGN", "TASKS", "IMPLEMENT", "TEST", "COMPREHENSION_REVIEW", "REFACTOR", "DELIVERY", "DONE"]
              },
              "from_revision": { "type": "integer", "minimum": 1 },
              "to_revision": { "type": "integer", "minimum": 1 },
              "progress": { "enum": ["read_before_retry_observed", "revision_advanced"] }
            }
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ordinary_zero_dispatch", "selector_guard", "six_tool_handshake", "graph_progression",
            "restart_resume", "uncertain_mutation_recovery", "comprehension", "refactor_retest",
            "core_done", "remove_readback", "data_retention", "repository_retention",
            "codex_non_interference", "exact_reinstall", "same_task_reopen", "read_only_reopen"
          ],
          "properties": {
            "ordinary_zero_dispatch": { "$ref": "#/$defs/passed" },
            "selector_guard": { "$ref": "#/$defs/passed" },
            "six_tool_handshake": { "$ref": "#/$defs/passed" },
            "graph_progression": { "$ref": "#/$defs/passed" },
            "restart_resume": { "$ref": "#/$defs/passed" },
            "uncertain_mutation_recovery": { "$ref": "#/$defs/passed" },
            "comprehension": { "$ref": "#/$defs/passed" },
            "refactor_retest": { "$ref": "#/$defs/passed" },
            "core_done": { "$ref": "#/$defs/passed" },
            "remove_readback": { "$ref": "#/$defs/passed" },
            "data_retention": { "$ref": "#/$defs/passed" },
            "repository_retention": { "$ref": "#/$defs/passed" },
            "codex_non_interference": { "$ref": "#/$defs/passed" },
            "exact_reinstall": { "$ref": "#/$defs/passed" },
            "same_task_reopen": { "$ref": "#/$defs/passed" },
            "read_only_reopen": { "$ref": "#/$defs/passed" }
          }
        },
        "release_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["npm_publish", "git_tag", "github_release", "version_change"],
          "properties": {
            "npm_publish": { "const": false },
            "git_tag": { "const": false },
            "github_release": { "const": false },
            "version_change": { "const": false }
          }
        }
      }
    },
    "historicalFailedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class", "status", "native_attempt", "failure_class",
        "bounded_diagnostic", "artifact_sha256", "publication_effects"
      ],
      "properties": {
        "evidence_class": { "const": "native_deepseek_graph_journey" },
        "status": { "const": "failed" },
        "native_attempt": { "enum": [1, 2] },
        "failure_class": { "enum": ["acceptance_assertion", "native_runner_error"] },
        "bounded_diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!.*(?:/Users/|/home/|DEEPSEEK_API_KEY|BEGIN [A-Z ]*PRIVATE KEY)).*$"
        },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "publication_effects": { "const": false }
      }
    },
    "failedAttempt3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class", "status", "native_attempt", "failure_class", "failed_stage",
        "bounded_diagnostic", "artifact_sha256", "final_task", "process_cleanup", "publication_effects"
      ],
      "properties": {
        "evidence_class": { "const": "native_deepseek_graph_journey" },
        "status": { "const": "failed" },
        "native_attempt": { "const": 3 },
        "failure_class": {
          "enum": [
            "acceptance_assertion", "native_runner_error", "stage_timeout",
            "stage_no_progress", "headless_failure"
          ]
        },
        "failed_stage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bounded_diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!.*(?:/Users/|/home/|DEEPSEEK_API_KEY|BEGIN [A-Z ]*PRIVATE KEY)).*$"
        },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "final_task": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "current_node", "revision", "origin_host"],
              "properties": {
                "task_id": { "type": "string", "pattern": "^task-[0-9a-f]+$" },
                "current_node": { "type": "string", "minLength": 1 },
                "revision": { "type": "integer", "minimum": 1 },
                "origin_host": { "const": "deepseek" }
              }
            }
          ]
        },
        "process_cleanup": { "enum": ["passed", "failed"] },
        "publication_effects": { "const": false }
      }
    },
    "failedAttempt4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class", "status", "native_attempt", "failure_class", "failed_stage",
        "bounded_diagnostic", "artifact_sha256", "final_task", "process_cleanup", "publication_effects"
      ],
      "properties": {
        "evidence_class": { "const": "native_deepseek_graph_journey" },
        "status": { "const": "failed" },
        "native_attempt": { "const": 4 },
        "failure_class": {
          "enum": [
            "acceptance_assertion", "native_runner_error", "stage_timeout",
            "stage_no_progress", "headless_failure"
          ]
        },
        "failed_stage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bounded_diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!.*(?:/Users/|/home/|DEEPSEEK_API_KEY|BEGIN [A-Z ]*PRIVATE KEY)).*$"
        },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "final_task": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "current_node", "revision", "origin_host"],
              "properties": {
                "task_id": { "type": "string", "pattern": "^task-[0-9a-f]+$" },
                "current_node": { "type": "string", "minLength": 1 },
                "revision": { "type": "integer", "minimum": 1 },
                "origin_host": { "const": "deepseek" }
              }
            }
          ]
        },
        "process_cleanup": { "enum": ["passed", "failed"] },
        "publication_effects": { "const": false }
      }
    }
  }
}
