{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow-result-envelope.schema.json",
  "title": "Dev Flow Result Envelope",
  "$comment": "Core Limits 0.1 enforces 1,048,576 actual UTF-8 JSON bytes for the complete compact envelope after encoding/json with HTML escaping disabled. A Domain-valid Task projection is at most 786,432 bytes and envelope overhead is at most 131,072 bytes, so their sum is strictly below the result limit. JSON Schema character lengths do not replace the encoded-byte check.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blockerCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expected_binding_digest"
      ],
      "properties": {
        "kind": {
          "const": "restore_issuance_binding"
        },
        "expected_binding_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "operationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_phase",
        "expected_revision",
        "action_id",
        "action_kind"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_phase": {
          "enum": [
            "INTAKE",
            "ASSESS",
            "PLAN",
            "IMPLEMENT",
            "VERIFY",
            "REVIEW",
            "HANDOFF",
            "BLOCKED"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "action_kind": {
          "enum": [
            "ASSESS_TASK",
            "PLAN_CHANGE",
            "IMPLEMENT_CHANGE",
            "VERIFY_CHANGE",
            "REVIEW_CHANGE",
            "PREPARE_HANDOFF",
            "RESOLVE_BLOCKER"
          ]
        }
      }
    },
    "committedOperationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "action_id",
        "from_revision",
        "to_revision",
        "payload_digest",
        "committed_at"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "apply_action"
        },
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "from_revision": {
          "type": "integer",
          "minimum": 1
        },
        "to_revision": {
          "type": "integer",
          "minimum": 2
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "recoveryAssessment": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Transient success-only five-class assessment. It is distinct from the top-level error-only recovery guidance object and never contains paths, source, diff, raw status, environment values, commands, or raw command output.",
      "required": [
        "classification",
        "operation",
        "task_revision",
        "current_action_id",
        "issuance_binding_digest",
        "authoritative_binding_digest",
        "observed_binding_digest",
        "repository_relation",
        "last_operation_relation",
        "operation_evidence",
        "operation_payload_digest",
        "committed_proof",
        "action_retry_safe",
        "next_advice",
        "unblock_condition",
        "observed_at"
      ],
      "properties": {
        "classification": {
          "enum": [
            "not_started",
            "completed_and_recorded",
            "completed_but_unrecorded",
            "partially_completed",
            "conflicting"
          ]
        },
        "operation": {
          "$ref": "#/$defs/operationReference"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "current_action_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuance_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "authoritative_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "observed_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "repository_relation": {
          "enum": [
            "exact",
            "worktree_only_changed",
            "forbidden_change"
          ]
        },
        "last_operation_relation": {
          "enum": [
            "exact",
            "unrelated",
            "contradictory"
          ]
        },
        "operation_evidence": {
          "enum": [
            "none",
            "complete",
            "contradictory"
          ]
        },
        "operation_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "committed_proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/committedOperationProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "action_retry_safe": {
          "type": "boolean"
        },
        "next_advice": {
          "enum": [
            "retry_current_action",
            "submit_recovery_apply",
            "read_next_action",
            "resolve_blocker",
            "stop_for_repository_drift"
          ]
        },
        "unblock_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/blockerCondition"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "request_id",
    "tool"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool": {
      "type": "string",
      "enum": [
        "dev_flow_server_info",
        "dev_flow_open_task",
        "dev_flow_get_task",
        "dev_flow_get_next_action",
        "dev_flow_apply_action",
        "dev_flow_cancel_task"
      ]
    },
    "result": {
      "type": "object",
      "$comment": "Typed result projections must use the same compact encoding and encoded-byte accounting; arbitrary map[string]any values are not Domain results. GetTask and GetNextAction read-success projections use this exact recovery_assessment definition when that member is present; ApplyAction does not.",
      "properties": {
        "recovery_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/recoveryAssessment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_GIT_REPOSITORY",
            "TASK_NOT_FOUND",
            "ACTIVE_TASK_CONFLICT",
            "HOST_OWNERSHIP_CONFLICT",
            "REVISION_CONFLICT",
            "ACTION_STALE",
            "REPOSITORY_DRIFT",
            "VERIFICATION_BUDGET_EXCEEDED",
            "TASK_BLOCKED",
            "TASK_TERMINAL",
            "SCHEMA_UNSUPPORTED",
            "STORAGE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "$comment": "Core Limits 0.1 also enforces this field as UTF-8 bytes at the adapter boundary.",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "object"
        }
      }
    },
    "recovery": {
      "type": "object",
      "$comment": "Error-only retry guidance. This is not RecoveryAssessment and never carries a five-class classification.",
      "additionalProperties": false,
      "required": [
        "retry_safe",
        "action",
        "message"
      ],
      "properties": {
        "retry_safe": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "none",
            "read_task",
            "read_next_action",
            "resolve_repository_drift",
            "use_origin_host",
            "cancel_or_finish_active_task",
            "repair_storage",
            "report_internal_error"
          ]
        },
        "message": {
          "type": "string",
          "$comment": "Core Limits 0.1 also enforces this field as UTF-8 bytes at the adapter boundary.",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "recovery"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "error",
          "recovery"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "tool": {
            "enum": [
              "dev_flow_get_task",
              "dev_flow_get_next_action"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "required": [
              "recovery_assessment"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "required": [
              "recovery_assessment"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tool": {
            "enum": [
              "dev_flow_get_task",
              "dev_flow_get_next_action"
            ]
          }
        }
      }
    }
  ]
}
