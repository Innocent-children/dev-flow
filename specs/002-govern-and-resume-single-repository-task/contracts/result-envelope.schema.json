{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dev-flow-result-envelope.schema.json",
  "title": "Dev Flow Result Envelope",
  "$comment": "Core Limits 0.1 enforces 1,048,576 actual UTF-8 JSON bytes for the complete compact envelope after encoding/json with HTML escaping disabled. A Domain-valid Task projection is at most 786,432 bytes and envelope overhead is at most 131,072 bytes, so their sum is strictly below the result limit. JSON Schema character lengths do not replace the encoded-byte check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "request_id",
    "tool"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool": {
      "type": "string",
      "enum": [
        "dev_flow_server_info",
        "dev_flow_open_task",
        "dev_flow_get_task",
        "dev_flow_get_next_action",
        "dev_flow_apply_action",
        "dev_flow_cancel_task"
      ]
    },
    "result": {
      "type": "object",
      "$comment": "Typed result projections must use the same compact encoding and encoded-byte accounting; arbitrary map[string]any values are not Domain results."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_GIT_REPOSITORY",
            "TASK_NOT_FOUND",
            "ACTIVE_TASK_CONFLICT",
            "HOST_OWNERSHIP_CONFLICT",
            "REVISION_CONFLICT",
            "ACTION_STALE",
            "REPOSITORY_DRIFT",
            "VERIFICATION_BUDGET_EXCEEDED",
            "TASK_BLOCKED",
            "TASK_TERMINAL",
            "SCHEMA_UNSUPPORTED",
            "STORAGE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "$comment": "Core Limits 0.1 also enforces this field as UTF-8 bytes at the adapter boundary.",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {
          "type": "object"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_safe",
        "action"
      ],
      "properties": {
        "retry_safe": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "none",
            "read_task",
            "read_next_action",
            "resolve_repository_drift",
            "use_origin_host",
            "cancel_or_finish_active_task",
            "repair_storage",
            "report_internal_error"
          ]
        },
        "message": {
          "type": "string",
          "$comment": "Core Limits 0.1 also enforces this field as UTF-8 bytes at the adapter boundary.",
          "maxLength": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error",
          "recovery"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    }
  ]
}
