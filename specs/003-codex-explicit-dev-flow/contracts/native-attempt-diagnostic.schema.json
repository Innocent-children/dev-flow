{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/native-attempt-diagnostic.schema.json",
  "title": "Dev Flow Codex Native Attempt Diagnostic",
  "description": "Closed external failed/blocked attempt record. It is never canonical support evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "status",
    "recorded_at",
    "classification",
    "versions",
    "identity",
    "validation",
    "native_attempt",
    "failure",
    "skips"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2, 3, 4]
    },
    "report_type": {
      "const": "dev-flow-codex-native-attempt-diagnostic"
    },
    "status": {
      "enum": ["failed", "blocked"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "host_surface", "os", "arch", "final_artifact"],
      "properties": {
        "evidence_type": {
          "const": "native-attempt-diagnostic"
        },
        "host_surface": {
          "const": "codex-cli"
        },
        "os": {
          "const": "darwin"
        },
        "arch": {
          "const": "arm64"
        },
        "final_artifact": {
          "const": true
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "codex_compatibility", "package", "core", "core_contract"],
      "properties": {
        "codex": {
          "$ref": "#/$defs/semver"
        },
        "codex_compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "package": {
          "$ref": "#/$defs/semver"
        },
        "core": {
          "$ref": "#/$defs/semver"
        },
        "core_contract": {
          "const": "0.1"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "artifact_sha256",
        "artifact_report_sha256",
        "artifact_built_at"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_built_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "completed_at", "targeted_checks", "root_validation"],
      "properties": {
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "targeted_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandObservation"
          }
        },
        "root_validation": {
          "$ref": "#/$defs/commandObservation"
        }
      }
    },
    "native_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "ledger_id",
        "attempt_number",
        "total_attempts",
        "ledger_sha256",
        "commit_protocol",
        "observed_facts_sha256"
      ],
      "properties": {
        "chain_id": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_id": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "total_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit_protocol": {
          "enum": [
            "external-failure-record-v1",
            "external-failure-record-v2",
            "external-failure-record-v3",
            "external-failure-record-v4"
          ]
        },
        "observed_facts_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "failure": {
      "oneOf": [
        { "$ref": "#/$defs/observationV1" },
        { "$ref": "#/$defs/observationV2" }
      ]
    },
    "failure_kind": {
      "enum": ["command_event", "mcp_event", "non_command"]
    },
    "failure_context": {
      "$ref": "#/$defs/failureContext"
    },
    "mcp_failure_context": {
      "$ref": "#/$defs/mcpFailureContext"
    },
    "session_observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/sessionObservation" },
            { "properties": { "session_role": { "const": "ordinary" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sessionObservation" },
            { "properties": { "session_role": { "const": "invalid" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sessionObservation" },
            { "properties": { "session_role": { "const": "substantive" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/sessionObservation" },
            { "properties": { "session_role": { "const": "resume" } } }
          ]
        }
      ],
      "items": false
    },
    "skips": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/observationV1" },
          { "$ref": "#/$defs/observationV2" }
        ]
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commandObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "source_commit", "completed_at"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "pass"
        },
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "observationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "reason", "observed"],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_code", "reason_code", "detail_sha256"],
      "properties": {
        "phase_code": {
          "enum": [
            "preflight",
            "setup",
            "codex-session",
            "finish",
            "candidate-validation",
            "publication",
            "recovery",
            "cleanup",
            "native-journey"
          ]
        },
        "reason_code": {
          "enum": [
            "command-event-rejected",
            "mcp-event-failed",
            "host-command-failed",
            "host-process-failed",
            "lifecycle-failed",
            "protocol-invalid",
            "candidate-invalid",
            "integrity-failed",
            "blocked",
            "unexpected-failure"
          ]
        },
        "detail_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "failureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_role",
        "event_type",
        "command_sha256",
        "output_sha256",
        "status",
        "exit_code"
      ],
      "properties": {
        "session_role": {
          "enum": ["ordinary", "invalid", "substantive", "resume"]
        },
        "event_type": {
          "const": "command_execution"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": ["completed", "failed", "declined"]
        },
        "exit_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        }
      }
    },
    "mcpFailureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_role",
        "event_type",
        "event_index",
        "tool",
        "status",
        "result_kind",
        "result_sha256",
        "error_sha256"
      ],
      "properties": {
        "session_role": {
          "enum": ["ordinary", "invalid", "substantive", "resume"]
        },
        "event_type": {
          "const": "mcp_tool_call"
        },
        "event_index": {
          "type": "integer",
          "minimum": 0
        },
        "tool": {
          "enum": [
            "dev_flow_server_info",
            "dev_flow_open_task",
            "dev_flow_get_task",
            "dev_flow_get_next_action",
            "dev_flow_apply_action",
            "dev_flow_cancel_task"
          ]
        },
        "status": {
          "const": "failed"
        },
        "result_kind": {
          "enum": ["tool_error_result", "transport_error"]
        },
        "result_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "error_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result_kind": { "const": "tool_error_result" }
            },
            "required": ["result_kind"]
          },
          "then": {
            "properties": {
              "result_sha256": { "$ref": "#/$defs/sha256" },
              "error_sha256": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "result_sha256": { "type": "null" },
              "error_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    },
    "sessionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_role",
        "failure_stage",
        "exit_code",
        "signal",
        "thread_present",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_sha256",
        "stderr_sha256",
        "event_counts",
        "item_counts",
        "mcp_status_counts"
      ],
      "properties": {
        "session_role": {
          "enum": ["ordinary", "invalid", "substantive", "resume"]
        },
        "failure_stage": {
          "enum": [
            "not_started",
            "spawn_failed",
            "capture_failed",
            "process_exited",
            "parse_failed",
            "mcp_failed",
            "completed",
            "stop_marker_missing"
          ]
        },
        "exit_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "signal": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 64 },
            { "type": "null" }
          ]
        },
        "thread_present": {
          "type": "boolean"
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_counts": {
          "$ref": "#/$defs/eventCounts"
        },
        "item_counts": {
          "$ref": "#/$defs/itemCounts"
        },
        "mcp_status_counts": {
          "$ref": "#/$defs/mcpStatusCounts"
        }
      }
    },
    "eventCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "invalid_json",
        "thread_started",
        "item_started",
        "item_completed",
        "turn_completed",
        "error",
        "other"
      ],
      "properties": {
        "total": { "$ref": "#/$defs/nonNegativeCount" },
        "invalid_json": { "$ref": "#/$defs/nonNegativeCount" },
        "thread_started": { "$ref": "#/$defs/nonNegativeCount" },
        "item_started": { "$ref": "#/$defs/nonNegativeCount" },
        "item_completed": { "$ref": "#/$defs/nonNegativeCount" },
        "turn_completed": { "$ref": "#/$defs/nonNegativeCount" },
        "error": { "$ref": "#/$defs/nonNegativeCount" },
        "other": { "$ref": "#/$defs/nonNegativeCount" }
      }
    },
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "agent_message", "command_execution", "mcp_tool_call", "other"],
      "properties": {
        "total": { "$ref": "#/$defs/nonNegativeCount" },
        "agent_message": { "$ref": "#/$defs/nonNegativeCount" },
        "command_execution": { "$ref": "#/$defs/nonNegativeCount" },
        "mcp_tool_call": { "$ref": "#/$defs/nonNegativeCount" },
        "other": { "$ref": "#/$defs/nonNegativeCount" }
      }
    },
    "mcpStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "dev_flow", "completed", "failed", "other"],
      "properties": {
        "total": { "$ref": "#/$defs/nonNegativeCount" },
        "dev_flow": { "$ref": "#/$defs/nonNegativeCount" },
        "completed": { "$ref": "#/$defs/nonNegativeCount" },
        "failed": { "$ref": "#/$defs/nonNegativeCount" },
        "other": { "$ref": "#/$defs/nonNegativeCount" }
      }
    },
    "nonNegativeCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": { "const": 1 }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "failure": { "$ref": "#/$defs/observationV1" },
          "skips": {
            "items": { "$ref": "#/$defs/observationV1" }
          },
          "native_attempt": {
            "properties": {
              "attempt_number": { "const": 1 },
              "total_attempts": { "const": 1 },
              "commit_protocol": { "const": "external-failure-record-v1" }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["failure_context"] },
            { "required": ["mcp_failure_context"] },
            { "required": ["failure_kind"] },
            { "required": ["session_observations"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": 2 }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["failure_kind"],
        "properties": {
          "failure_kind": { "enum": ["command_event", "non_command"] },
          "failure": { "$ref": "#/$defs/observationV2" },
          "skips": {
            "items": { "$ref": "#/$defs/observationV2" }
          },
          "native_attempt": {
            "properties": {
              "attempt_number": { "const": 2 },
              "total_attempts": { "const": 2 },
              "commit_protocol": { "const": "external-failure-record-v2" }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["session_observations"] },
            { "required": ["mcp_failure_context"] }
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "failure_kind": { "const": "command_event" }
              },
              "required": ["failure_kind"]
            },
            "then": {
              "required": ["failure_context"]
            },
            "else": {
              "not": {
                "required": ["failure_context"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": 3 }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["failure_kind", "session_observations"],
        "properties": {
          "failure_kind": { "enum": ["command_event", "non_command"] },
          "failure": { "$ref": "#/$defs/observationV2" },
          "skips": {
            "items": { "$ref": "#/$defs/observationV2" }
          },
          "native_attempt": {
            "properties": {
              "attempt_number": { "const": 3 },
              "total_attempts": { "const": 3 },
              "commit_protocol": { "const": "external-failure-record-v3" }
            }
          }
        },
        "not": {
          "required": ["mcp_failure_context"]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "failure_kind": { "const": "command_event" }
              },
              "required": ["failure_kind"]
            },
            "then": {
              "required": ["failure_context"]
            },
            "else": {
              "not": {
                "required": ["failure_context"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": 4 }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["failure_kind", "session_observations"],
        "properties": {
          "failure": { "$ref": "#/$defs/observationV2" },
          "skips": {
            "items": { "$ref": "#/$defs/observationV2" }
          },
          "native_attempt": {
            "properties": {
              "attempt_number": { "type": "integer", "minimum": 4 },
              "total_attempts": { "type": "integer", "minimum": 4 },
              "commit_protocol": { "const": "external-failure-record-v4" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "failure_kind": { "const": "command_event" }
              },
              "required": ["failure_kind"]
            },
            "then": {
              "required": ["failure_context"],
              "not": { "required": ["mcp_failure_context"] }
            },
            "else": {
              "not": { "required": ["failure_context"] }
            }
          },
          {
            "if": {
              "properties": {
                "failure_kind": { "const": "mcp_event" }
              },
              "required": ["failure_kind"]
            },
            "then": {
              "required": ["mcp_failure_context"],
              "not": { "required": ["failure_context"] },
              "properties": {
                "failure": {
                  "properties": {
                    "phase_code": { "const": "codex-session" },
                    "reason_code": { "const": "mcp-event-failed" }
                  }
                }
              }
            },
            "else": {
              "not": { "required": ["mcp_failure_context"] }
            }
          }
        ]
      }
    }
  ]
}
