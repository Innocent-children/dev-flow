{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/artifact-report.schema.json",
  "title": "Dev Flow Codex Final Artifact Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "artifact_path",
    "artifact_sha256",
    "package_version",
    "core_version",
    "codex_compatibility",
    "source_commit",
    "source_dirty",
    "final_artifact",
    "platform",
    "package_allowlist_verified",
    "runtime_executable_verified",
    "built_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "dev-flow-codex-final-artifact"
    },
    "artifact_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "package_version": {
      "$ref": "#/$defs/semver"
    },
    "core_version": {
      "$ref": "#/$defs/semver"
    },
    "codex_compatibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_dirty": {
      "const": false
    },
    "final_artifact": {
      "const": true
    },
    "platform": {
      "const": "darwin-arm64"
    },
    "package_allowlist_verified": {
      "const": true
    },
    "runtime_executable_verified": {
      "const": true
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
