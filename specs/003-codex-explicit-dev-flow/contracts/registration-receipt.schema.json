{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/registration-receipt.schema.json",
  "title": "Dev Flow Codex Registration Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "host",
    "registration",
    "paths",
    "resource_digests",
    "installed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "core_version",
        "codex_compatibility"
      ],
      "properties": {
        "name": {
          "const": "dev-flow-codex"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "core_version": {
          "$ref": "#/$defs/semver"
        },
        "codex_compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "version", "os", "arch"],
      "properties": {
        "surface": {
          "const": "codex-cli"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "os": {
          "const": "darwin"
        },
        "arch": {
          "const": "arm64"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketplace_name",
        "marketplace_root",
        "plugin_name",
        "plugin_selector",
        "plugin_root"
      ],
      "properties": {
        "marketplace_name": {
          "const": "dev-flow-local"
        },
        "marketplace_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "plugin_name": {
          "const": "dev-flow-codex"
        },
        "plugin_selector": {
          "const": "dev-flow-codex@dev-flow-local"
        },
        "plugin_root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_root", "runtime_path", "data_dir", "receipt_path"],
      "properties": {
        "package_root": {
          "$ref": "#/$defs/absolutePath"
        },
        "runtime_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "data_dir": {
          "$ref": "#/$defs/absolutePath"
        },
        "receipt_path": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "resource_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_manifest", "skill", "mcp_configuration"],
      "properties": {
        "plugin_manifest": {
          "$ref": "#/$defs/sha256"
        },
        "skill": {
          "$ref": "#/$defs/sha256"
        },
        "mcp_configuration": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2
    }
  }
}
