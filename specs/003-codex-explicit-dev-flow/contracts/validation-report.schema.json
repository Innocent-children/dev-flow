{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/validation-report.schema.json",
  "title": "Dev Flow Codex Frozen-Source Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "source_commit",
    "source_dirty",
    "attempt_ledger_id",
    "codex_revalidation",
    "completed_at",
    "targeted_checks",
    "root_validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "dev-flow-codex-validation"
    },
    "source_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_dirty": {
      "const": false
    },
    "attempt_ledger_id": {
      "$ref": "#/$defs/sha256"
    },
    "codex_revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "dist_tag", "resolved_version", "compatible_range", "queried_at"],
      "properties": {
        "package": {
          "const": "@openai/codex"
        },
        "dist_tag": {
          "const": "latest"
        },
        "resolved_version": {
          "$ref": "#/$defs/semver"
        },
        "compatible_range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "queried_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "targeted_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/passingCommand"
      }
    },
    "root_validation": {
      "allOf": [
        {
          "$ref": "#/$defs/passingCommand"
        },
        {
          "properties": {
            "command": {
              "const": "pnpm run validate"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "passingCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "source_commit", "completed_at"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "result": {
          "const": "pass"
        },
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
