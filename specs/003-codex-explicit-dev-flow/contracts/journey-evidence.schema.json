{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/journey-evidence.schema.json",
  "title": "Dev Flow Codex Native Journey Evidence",
  "description": "Structural validation only. Passing semantic relationships are enforced by scripts/validate-codex-journey-evidence.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "recorded_at",
    "classification",
    "versions",
    "identity",
    "validation",
    "native_attempt",
    "journey",
    "failures",
    "skips"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "status": {
      "const": "pass"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "host_surface", "os", "arch", "final_artifact"],
      "properties": {
        "evidence_type": {
          "const": "native-host"
        },
        "host_surface": {
          "const": "codex-cli"
        },
        "os": {
          "const": "darwin"
        },
        "arch": {
          "const": "arm64"
        },
        "final_artifact": {
          "const": true
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "codex_compatibility", "package", "core", "core_contract"],
      "properties": {
        "codex": {
          "description": "Exact stable Codex CLI version observed by the unique passing native journey.",
          "$ref": "#/$defs/semver"
        },
        "codex_compatibility": {
          "description": "Bounded compatibility range selected by the serialized implementation-time review.",
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "package": {
          "$ref": "#/$defs/semver"
        },
        "core": {
          "$ref": "#/$defs/semver"
        },
        "core_contract": {
          "const": "0.1"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "artifact_sha256",
        "artifact_report_sha256",
        "artifact_built_at",
        "shared_fixtures_sha256"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_built_at": {
          "type": "string",
          "format": "date-time"
        },
        "shared_fixtures_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "completed_at", "targeted_checks", "root_validation"],
      "properties": {
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "targeted_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandObservation"
          }
        },
        "root_validation": {
          "allOf": [
            {
              "$ref": "#/$defs/commandObservation"
            },
            {
              "properties": {
                "command": {
                  "const": "pnpm run validate"
                }
              }
            }
          ]
        }
      }
    },
    "native_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "ledger_id",
        "attempt_number",
        "total_attempts",
        "ledger_sha256",
        "commit_protocol",
        "observed_facts_sha256"
      ],
      "properties": {
        "chain_id": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_id": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "total_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit_protocol": {
          "const": "evidence-create-before-ledger-finalize-v1"
        },
        "observed_facts_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "journey": {
      "$ref": "#/$defs/journey"
    },
    "failures": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "skips": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2
    },
    "commandObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result",
        "source_commit",
        "completed_at"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "pass"
        },
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "verificationBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "max_automatic_commands", "allow_full_suite", "allow_manual_handoff"],
      "properties": {
        "level": {
          "enum": ["minimal", "targeted", "full"]
        },
        "max_automatic_commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "allow_full_suite": {
          "type": "boolean"
        },
        "allow_manual_handoff": {
          "type": "boolean"
        }
      }
    },
    "commandExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "command", "exit_code", "status", "output_sha256", "full_suite"],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "const": 0
        },
        "status": {
          "const": "completed"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "full_suite": {
          "type": "boolean"
        }
      }
    },
    "registryReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketplaces_total",
        "installed_total",
        "available_total",
        "marketplace_name",
        "plugin_id",
        "plugin_version"
      ],
      "properties": {
        "marketplaces_total": {
          "const": 1
        },
        "installed_total": {
          "const": 1
        },
        "available_total": {
          "const": 0
        },
        "marketplace_name": {
          "const": "dev-flow-local"
        },
        "plugin_id": {
          "const": "dev-flow-codex@dev-flow-local"
        },
        "plugin_version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "retainedDataLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workspace_relative_path", "canonical_path_sha256"],
      "properties": {
        "kind": {
          "const": "isolated-explicit-data-directory"
        },
        "workspace_relative_path": {
          "const": "data"
        },
        "canonical_path_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_lineage", "invocation", "lifecycle", "repository", "task_data"],
      "properties": {
        "task_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thread_ids",
            "task_id_before_restart",
            "task_id_after_restart",
            "raw_revisions",
            "revisions",
            "committed_actions",
            "terminal_phase",
            "terminal_outcome"
          ],
          "properties": {
            "thread_ids": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_id_before_restart": {
              "type": "string",
              "minLength": 1
            },
            "task_id_after_restart": {
              "type": "string",
              "minLength": 1
            },
            "revisions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "raw_revisions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "committed_actions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action_id",
                  "revision",
                  "arguments_sha256",
                  "result_sha256"
                ],
                "properties": {
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "arguments_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "result_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "terminal_outcome": {
              "const": "DONE"
            },
            "terminal_phase": {
              "const": "DONE"
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit_selector",
            "core_call_count",
            "scenario_call_budget",
            "implicit_invocation_core_calls",
            "read_before_retry_observations",
            "restart_recovery_reads",
            "verification_budget",
            "verification_commands",
            "submitted_automated_command_count",
            "retained_automated_command_count",
            "submitted_full_suite",
            "retained_full_suite"
          ],
          "properties": {
            "explicit_selector": {
              "const": "$dev-flow"
            },
            "core_call_count": {
              "type": "integer",
              "minimum": 1
            },
            "scenario_call_budget": {
              "type": "integer",
              "minimum": 1
            },
            "implicit_invocation_core_calls": {
              "const": 0
            },
            "read_before_retry_observations": {
              "type": "integer",
              "minimum": 1
            },
            "restart_recovery_reads": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "const": "dev_flow_get_task" },
                { "const": "dev_flow_get_next_action" }
              ],
              "items": false
            },
            "verification_budget": {
              "$ref": "#/$defs/verificationBudget"
            },
            "verification_commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/commandExecution"
              }
            },
            "submitted_automated_command_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "retained_automated_command_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "submitted_full_suite": {
              "type": "boolean"
            },
            "retained_full_suite": {
              "type": "boolean"
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setup_readback_passed",
            "setup_registry",
            "restart_resume_passed",
            "remove_readback_passed",
            "task_data_retained",
            "task_reopened_after_removal",
            "compatible_reinstall_passed",
            "reinstall_registry"
          ],
          "properties": {
            "setup_readback_passed": {
              "type": "boolean"
            },
            "setup_registry": {
              "$ref": "#/$defs/registryReadback"
            },
            "restart_resume_passed": {
              "type": "boolean"
            },
            "remove_readback_passed": {
              "type": "boolean"
            },
            "task_data_retained": {
              "type": "boolean"
            },
            "task_reopened_after_removal": {
              "type": "boolean"
            },
            "compatible_reinstall_passed": {
              "type": "boolean"
            },
            "reinstall_registry": {
              "$ref": "#/$defs/registryReadback"
            }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_path",
            "digest_before",
            "digest_after_completion",
            "digest_after_removal",
            "intended_changed_paths",
            "unexpected_changed_paths"
          ],
          "properties": {
            "target_path": {
              "$ref": "#/$defs/absolutePath"
            },
            "digest_before": {
              "$ref": "#/$defs/sha256"
            },
            "digest_after_completion": {
              "$ref": "#/$defs/sha256"
            },
            "digest_after_removal": {
              "$ref": "#/$defs/sha256"
            },
            "intended_changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unexpected_changed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "task_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_before_removal_sha256",
            "manifest_after_removal_sha256",
            "files_before_removal",
            "files_after_removal",
            "retained_data_location"
          ],
          "properties": {
            "manifest_before_removal_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "manifest_after_removal_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "files_before_removal": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "files_after_removal": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "retained_data_location": {
              "$ref": "#/$defs/retainedDataLocation"
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "reason", "observed"],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
