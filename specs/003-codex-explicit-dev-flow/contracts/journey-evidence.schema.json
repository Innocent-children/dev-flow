{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/contracts/003/journey-evidence.schema.json",
  "title": "Dev Flow Codex Native Journey Evidence",
  "description": "Structural validation only. Passing semantic relationships are enforced by scripts/validate-codex-journey-evidence.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "recorded_at",
    "classification",
    "versions",
    "identity",
    "validation",
    "failures",
    "skips"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": ["pass", "failed", "blocked"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "host_surface", "os", "arch", "final_artifact"],
      "properties": {
        "evidence_type": {
          "const": "native-host"
        },
        "host_surface": {
          "const": "codex-cli"
        },
        "os": {
          "const": "darwin"
        },
        "arch": {
          "const": "arm64"
        },
        "final_artifact": {
          "const": true
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "codex_compatibility", "package", "core", "core_contract"],
      "properties": {
        "codex": {
          "$ref": "#/$defs/semver"
        },
        "codex_compatibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "package": {
          "$ref": "#/$defs/semver"
        },
        "core": {
          "$ref": "#/$defs/semver"
        },
        "core_contract": {
          "const": "0.1"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "artifact_sha256",
        "shared_fixtures_sha256"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shared_fixtures_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targeted_checks", "root_validation"],
      "properties": {
        "targeted_checks": {
          "$ref": "#/$defs/commandObservation"
        },
        "root_validation": {
          "allOf": [
            {
              "$ref": "#/$defs/commandObservation"
            },
            {
              "properties": {
                "command": {
                  "const": "pnpm run validate"
                }
              }
            }
          ]
        }
      }
    },
    "journey": {
      "$ref": "#/$defs/journey"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "skips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["journey"],
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "skips": {
            "maxItems": 0
          },
          "validation": {
            "properties": {
              "targeted_checks": {
                "properties": {
                  "result": {
                    "const": "pass"
                  }
                }
              },
              "root_validation": {
                "properties": {
                  "result": {
                    "const": "pass"
                  }
                }
              }
            }
          },
          "journey": {
            "required": [
              "task_lineage",
              "invocation",
              "lifecycle",
              "repository",
              "task_data"
            ],
            "properties": {
              "task_lineage": {
                "required": [
                  "task_id_before_restart",
                  "task_id_after_restart",
                  "revisions",
                  "committed_actions",
                  "terminal_outcome"
                ]
              },
              "invocation": {
                "required": [
                  "explicit_selector",
                  "core_call_count",
                  "scenario_call_budget",
                  "implicit_invocation_core_calls",
                  "read_before_retry_observations"
                ]
              },
              "lifecycle": {
                "required": [
                  "setup_readback_passed",
                  "restart_resume_passed",
                  "remove_readback_passed",
                  "task_data_retained",
                  "task_reopened_after_removal",
                  "compatible_reinstall_passed"
                ]
              },
              "repository": {
                "required": [
                  "target_path",
                  "digest_before",
                  "digest_after_completion",
                  "digest_after_removal",
                  "intended_changed_paths",
                  "unexpected_changed_paths"
                ]
              },
              "task_data": {
                "required": [
                  "manifest_before_removal_sha256",
                  "manifest_after_removal_sha256",
                  "files_before_removal",
                  "files_after_removal"
                ]
              }
            }
          }
        }
      },
      "else": {
        "anyOf": [
          {
            "properties": {
              "failures": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "skips": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2
    },
    "commandObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result",
        "source_commit",
        "completed_at"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["pass", "failed", "blocked"]
        },
        "source_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_lineage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id_before_restart": {
              "type": "string",
              "minLength": 1
            },
            "task_id_after_restart": {
              "type": "string",
              "minLength": 1
            },
            "revisions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "committed_actions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action_id",
                  "revision",
                  "arguments_sha256",
                  "result_sha256"
                ],
                "properties": {
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "arguments_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "result_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "terminal_outcome": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "explicit_selector": {
              "const": "$dev-flow"
            },
            "core_call_count": {
              "type": "integer",
              "minimum": 1
            },
            "scenario_call_budget": {
              "type": "integer",
              "minimum": 1
            },
            "implicit_invocation_core_calls": {
              "const": 0
            },
            "read_before_retry_observations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "setup_readback_passed": {
              "type": "boolean"
            },
            "restart_resume_passed": {
              "type": "boolean"
            },
            "remove_readback_passed": {
              "type": "boolean"
            },
            "task_data_retained": {
              "type": "boolean"
            },
            "task_reopened_after_removal": {
              "type": "boolean"
            },
            "compatible_reinstall_passed": {
              "type": "boolean"
            }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_path": {
              "$ref": "#/$defs/absolutePath"
            },
            "digest_before": {
              "$ref": "#/$defs/sha256"
            },
            "digest_after_completion": {
              "$ref": "#/$defs/sha256"
            },
            "digest_after_removal": {
              "$ref": "#/$defs/sha256"
            },
            "intended_changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unexpected_changed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "task_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manifest_before_removal_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "manifest_after_removal_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "files_before_removal": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "files_after_removal": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "reason", "observed"],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
